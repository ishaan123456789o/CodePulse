# Copy to .env; never commit credentials.
GITHUB_TOKEN=
POSTGRES_DB=codepulse
POSTGRES_USER=codepulse
POSTGRES_PASSWORD=codepulse-local
DATABASE_URL=postgresql+asyncpg://codepulse:codepulse-local@localhost:5432/codepulse
REDIS_URL=redis://localhost:6379/0
API_INTERNAL_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
DEMO_MODE=false
DISCOVERY_REQUEST_BUDGET=10
TRACKING_REQUEST_BUDGET=60
DISCOVERY_INTERVAL_SECONDS=21600
TRACK_HIGH_HOURS=1
TRACK_NORMAL_HOURS=6
TRACK_LOW_HOURS=24
GITHUB_MIN_INTERVAL_SECONDS=2
# Optional enrichment costs up to 2 extra requests per repository.
OPTIONAL_ACTIVITY_ENABLED=false
SUMMARY_CACHE_SECONDS=30
# JSON arrays; default topics span all ten product categories.
DISCOVERY_LANGUAGES=[]
DISCOVERY_EXTRA_QUERIES=[]
